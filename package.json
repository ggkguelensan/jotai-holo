{
  "name": "jotai-holo",
  "version": "0.1.0",
  "description": "Declarative React bindings for Jotai models.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggkguelensan/jotai-holo.git"
  },
  "homepage": "https://github.com/ggkguelensan/jotai-holo#readme",
  "bugs": {
    "url": "https://github.com/ggkguelensan/jotai-holo/issues"
  },
  "keywords": [
    "jotai",
    "react",
    "state",
    "hoc",
    "bindings"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "examples": "vite --config examples/vite.config.ts --host 127.0.0.1",
    "examples:build": "vite build --config examples/vite.config.ts",
    "check": "pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm test:compat && pnpm test:browser && pnpm examples:build",
    "prepack": "pnpm build",
    "test:package": "node scripts/test-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "pnpm build && node scripts/measure-bundle.mjs"
  },
  "peerDependencies": {
    "@types/react": ">=19 <20",
    "jotai": ">=3.0.1 <4",
    "react": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser-playwright": "4.1.6",
    "bunshi": "2.2.0",
    "immer": "11.2.9",
    "jotai": "3.0.1",
    "jotai-effect": "2.4.2",
    "jotai-family": "1.1.0",
    "jotai-history": "0.6.0",
    "jotai-immer": "0.4.3",
    "jotai-optics": "0.4.0",
    "jotai-scope": "0.12.2",
    "jotai-tanstack-query": "0.11.0",
    "jotai-xstate": "0.6.1",
    "optics-ts": "2.4.1",
    "playwright": "1.60.0",
    "prettier": "3.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "typescript": "~5.9.3",
    "vite": "8.0.13",
    "vitest": "4.1.6",
    "xstate": "5.33.3"
  }
}
