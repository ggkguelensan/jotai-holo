{
  "name": "jotai-holo",
  "version": "0.1.0",
  "description": "Declarative React bindings for Jotai models.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggkguelensan/jotai-holo.git"
  },
  "homepage": "https://github.com/ggkguelensan/jotai-holo#readme",
  "bugs": {
    "url": "https://github.com/ggkguelensan/jotai-holo/issues"
  },
  "keywords": [
    "jotai",
    "react",
    "state",
    "hoc",
    "bindings"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    },
    "./package.json": "./package.json",
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    },
    "./rhf": {
      "types": "./dist/rhf.d.ts",
      "import": "./dist/rhf.js"
    },
    "./persist": {
      "types": "./dist/persist.d.ts",
      "import": "./dist/persist.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./analytics/amplitude": {
      "types": "./dist/analytics-amplitude.d.ts",
      "import": "./dist/analytics-amplitude.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "examples": "vite --config examples/vite.config.ts --host 127.0.0.1",
    "examples:build": "vite build --config examples/vite.config.ts",
    "check": "pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm test:compat && pnpm test:browser && pnpm examples:build",
    "prepack": "pnpm build",
    "test:package": "node scripts/test-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "pnpm build && node scripts/measure-bundle.mjs",
    "test:memory": "pnpm build && node scripts/test-holo-memory.mjs",
    "docs:dev": "pnpm docs:prepare && vitepress dev docs",
    "docs:build": "pnpm docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "pnpm docs:prepare && pnpm i18n:test && node scripts/check-doc-examples.mjs && node scripts/test-code-blocks.mjs && node scripts/check-docs.mjs && node scripts/check-doc-graphs.mjs && node scripts/test-source-scene.mjs && node scripts/check-generated-graphs.mjs && tsc -p docs/.vitepress/graph/tsconfig.json --noEmit",
    "test:docs": "node scripts/test-docs.mjs",
    "test:react": "node scripts/test-react-compat.mjs",
    "test:model-memory": "pnpm build && node --expose-gc scripts/test-model-memory.mjs",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict",
    "docs:prepare": "pnpm i18n:extract && pnpm i18n:compile && node scripts/localize-docs.mjs",
    "i18n:test": "node scripts/test-docs-i18n.mjs",
    "test:mutation-memory": "pnpm build && node --expose-gc scripts/test-mutation-memory.mjs",
    "test:analytics-adapter": "node scripts/test-analytics-adapter.mjs",
    "test:composition-memory": "pnpm build && node --expose-gc scripts/test-model-composition-memory.mjs",
    "test:docs-analytics": "node scripts/test-doc-analytics.mjs",
    "test:docs-graphs": "node scripts/test-doc-graphs.mjs",
    "test:docs-annotations": "node scripts/test-doc-annotations.mjs",
    "test:docs-spreadsheet": "node scripts/test-doc-spreadsheet.mjs"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=5.104.5 <6",
    "@types/react": ">=18 <20",
    "jotai": ">=3.0.1 <4",
    "react": ">=18 <20",
    "react-hook-form": ">=7.91.0 <8"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@hookform/resolvers": "6.0.0",
    "@lingui/babel-plugin-lingui-macro": "6.10.1",
    "@lingui/cli": "6.10.1",
    "@lingui/core": "6.10.1",
    "@lingui/format-po": "6.10.1",
    "@lingui/message-utils": "6.10.1",
    "@lingui/react": "6.10.1",
    "@siberiacancode/reactuse": "1.0.17",
    "@tanstack/query-core": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser-playwright": "4.1.6",
    "immer": "11.2.9",
    "jotai": "3.0.1",
    "jotai-effect": "2.4.2",
    "jotai-family": "1.1.0",
    "jotai-history": "0.6.0",
    "jotai-immer": "0.4.3",
    "jotai-optics": "0.4.0",
    "jotai-scope": "0.12.2",
    "jotai-tanstack-query": "0.11.0",
    "jotai-xstate": "0.6.1",
    "motion": "14.7.1",
    "optics-ts": "2.4.1",
    "playwright": "1.60.0",
    "prettier": "3.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "rxjs": "7.8.2",
    "typescript": "~5.9.3",
    "vite": "8.0.13",
    "vitepress": "1.6.4",
    "vitest": "4.1.6",
    "vue": "3.5.44",
    "xstate": "5.33.3",
    "yaml": "2.8.3",
    "zod": "4.6.7"
  }
}
