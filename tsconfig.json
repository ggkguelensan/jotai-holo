{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "jotai-holo": ["./src/index.ts"],
      "jotai-holo/vanilla": ["./src/vanilla.ts"],
      "jotai-holo/model": ["./src/model.ts"],
      "jotai-holo/query": ["./src/query.ts"],
      "jotai-holo/rhf": ["./src/rhf.ts"],
      "jotai-holo/persist": ["./src/persist.ts"]
    }
  },
  "include": ["src", "tests", "examples", "*.config.ts"]
}
